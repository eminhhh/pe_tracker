# Copy this file to .env/projecteuler.env for local runs.
# In CI, PJ_COOKIE is passed directly from the PE_PJ_COOKIE GitHub secret.
# PJ_COOKIE accepts the value of `__Host-PHPSESSID` or a Cookie request header.
# Header example (placeholder values): __Host-PHPSESSID=session; DYNSRV=server

PJ_COOKIE=
